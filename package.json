{
  "name": "maviri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node scripts/ensure-development-database.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-database.ps1",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-database.ps1",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local-database.ps1",
    "smoke:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-backend.ps1",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.18",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.18",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
