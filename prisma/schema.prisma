generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  username          String?            @unique
  bio               String?            @db.VarChar(280)
  bannerUrl         String?
  profileTheme      String             @default("paper")
  role              String             @default("MEMBER")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  accounts          Account[]
  animeEntries      AnimeListEntry[]
  customLists       AnimeCustomList[]
  posts             Post[]
  comments          Comment[]
  likes             PostLike[]
  bookmarks         PostBookmark[]
  reposts           PostRepost[]
  following         Follow[]           @relation("FollowSource")
  followers         Follow[]           @relation("FollowTarget")
  notifications     Notification[]     @relation("NotificationRecipient")
  sentNotifications Notification[]     @relation("NotificationActor")
  reports           Report[]
  moderationActions ModerationAction[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AnimeListEntry {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  aniListMediaId  Int
  status          AnimeListStatus
  episodesWatched Int              @default(0)
  rewatchCount    Int              @default(0)
  personalScore   Int?
  startedAt       DateTime?
  completedAt     DateTime?
  personalNotes   String?
  customListId    String?
  customList      AnimeCustomList? @relation(fields: [customListId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, aniListMediaId])
  @@index([userId, status])
  @@index([customListId])
}

model AnimeCustomList {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String           @db.VarChar(48)
  description String?          @db.VarChar(160)
  entries     AnimeListEntry[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, name])
  @@index([userId, createdAt])
}

enum AnimeListStatus {
  WATCHING
  COMPLETED
  PLANNING
  PAUSED
  DROPPED
}

model Post {
  id             String         @id @default(cuid())
  authorId       String
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String         @db.VarChar(1200)
  kind           String         @default("TEXT")
  aniListMediaId Int?
  reviewScore    Int?
  mediaUrl       String?
  mediaAlt       String?        @db.VarChar(160)
  quotedPostId   String?
  quotedPost     Post?          @relation("PostQuote", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotedBy       Post[]         @relation("PostQuote")
  comments       Comment[]
  likes          PostLike[]
  bookmarks      PostBookmark[]
  reposts        PostRepost[]
  reports        Report[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([createdAt, id])
  @@index([authorId, createdAt])
  @@index([aniListMediaId])
}

model Comment {
  id              String    @id @default(cuid())
  postId          String
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId        String
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentCommentId String?
  parentComment   Comment?  @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentThread")
  content         String    @db.VarChar(800)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([postId, createdAt])
  @@index([parentCommentId, createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model PostBookmark {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model PostRepost {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("FollowSource", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowTarget", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  kind        String
  entityId    String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt, createdAt])
}

model Report {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reason     String    @db.VarChar(500)
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@unique([reporterId, postId])
  @@index([status, createdAt])
}

model ModerationAction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  targetId  String
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}
